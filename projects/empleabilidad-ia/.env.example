# Base de datos: Postgres administrado (Neon). Todo el pipeline lee y escribe
# aquí; no hay base local. Usa el connection string con sslmode=require.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Extracción con LLM (processor.py). Se factura aparte de cualquier
# suscripción de Claude: es la API, no el chat.
# El modelo se elige en processor.py, constante MODELO.
#   claude-haiku-4-5  ~$0.25 por 100 ofertas   (el usado en este proyecto)
#   claude-sonnet-5   ~$0.70 por 100 ofertas
#   claude-opus-5     ~$1.20 por 100 ofertas
# OJO: Haiku 4.5 rechaza output_config.effort con un 400. Si subes de modelo,
# pon EFFORT = "medium" en processor.py.
ANTHROPIC_API_KEY=

# Scraping de LinkedIn (scraper_linkedin.py) vía el actor
# curious_coder/linkedin-jobs-scraper. Cuesta ~$0.85 por keyword (20 resultados).
# El plan FREE de Apify da $5 mensuales, que alcanzan para ~6 búsquedas.
# Laborum NO necesita credenciales: parsea HTML público.
APIFY_API_KEY=

# API REST de Neon. Opcional: ningún script del pipeline la usa hoy, queda
# disponible para dashboards o consultas desde el frontend.
NEON_DATA_API_URL=
NEON_API_KEY=
