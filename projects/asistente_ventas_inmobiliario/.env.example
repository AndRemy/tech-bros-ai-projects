# Base de datos: Postgres administrado (Neon). El pipeline de scraping/ETL
# (scrapper/, database/db.py) sigue usando SQLite local (./data/real_estate.db)
# para desarrollo; el bot lee de la tabla `apartments` en Postgres.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Scraping (Apify)
APIFY_API_TOKEN=

# Proveedor de LLM: anthropic | openai | gemini (ver bot/llm/factory.py).
# Solo hace falta la API key del proveedor elegido.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Canales: lista separada por comas de los canales activos (ver
# bot/adapters/factory.py para los nombres disponibles). Cada uno corre en
# paralelo con su propio token.
ENABLED_CHANNELS=telegram,discord
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Sesión de conversación
SESSION_TTL_SECONDS=1800
